# Godot 4 .gitignore

# Godot-specific ignores
.godot/
*.translation

# Exported projects
*.apk
*.aab
*.ipa
*.exe
*.pck
*.zip

# Android export
android/
*.keystore

# macOS
.DS_Store

# Windows
Thumbs.db

# Third-party addons
addons/gut/

# Generated from full_design/data/*.csv by build_values.py — regenerate on
# demand, never hand-edited or committed (see full_design/data/build_values.py)
full_design/data/*.values.csv
